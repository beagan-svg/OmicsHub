# Django
SECRET_KEY=change-me
DATABASE_URL=postgres://omicshub:omicshub@localhost:5432/omicshub

# Leave DEBUG on for local-only work. Turn it OFF before forwarding the port to anyone
# else: the debug error page shows tracebacks, local variables, and settings.
DEBUG=True

# Path the Django admin is mounted at, without slashes. Defaults to "admin". Change it to
# anything else before this is reachable by more than this machine: the admin can edit
# users and activate a config, and /admin/ is the first path a scanner tries.
ADMIN_URL=admin
ALLOWED_HOSTS=localhost,127.0.0.1
# When forwarding port 8000 through VS Code, add the tunnel host and its https origin:
#   ALLOWED_HOSTS=localhost,127.0.0.1,abc123-8000.usw2.devtunnels.ms
#   CSRF_TRUSTED_ORIGINS=https://abc123-8000.usw2.devtunnels.ms
CSRF_TRUSTED_ORIGINS=

# OCS
# Environment base that prefixes every OCS DynamoDB table (e.g. "prod" -> "prod-fastq-metadata").
OCS_ENV_BASE=prod
OCS_AWS_REGION=us-west-2
# Path to the `ocs` executable, used only to submit alignment and post-alignment demands.
OCS_CLI_PATH=/path/to/genomics-cloud-services/gcs-cli/.venv/bin/ocs
# Colon-separated src directories the CLI needs on PYTHONPATH — the same ones the
# interactive `activateocs` shell function exports. The worker is not a login shell, so it
# gets none of that setup unless it is named here.
OCS_CLI_PYTHONPATH=/path/to/genomics-cloud-services/gcs-cli/src:/path/to/genomics-cloud-services/gcs-core/src:/path/to/genomics-cloud-services/gcs-api-client/src:/path/to/genomics-cloud-services/gcs-docker-tools/src
OCS_CLI_TIMEOUT=300

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0

# AWS
# Use a static-key profile rather than SSO: the Celery worker and beat run unattended and
# cannot refresh an SSO session. On EC2/ECS prefer an instance role and leave both unset.
#
# The credentials live in their own file rather than ~/.aws/credentials, so this key is
# reachable only from this app. Everything else on the machine keeps using whatever
# profiles are in ~/.aws/config.
#
#   mkdir -p ~/.omicshub && chmod 700 ~/.omicshub
#   AWS_SHARED_CREDENTIALS_FILE=~/.omicshub/credentials aws configure --profile omicshub
#
# Never put AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in this file or anywhere else in the
# repo — only the profile name and the path belong here.
AWS_PROFILE=omicshub
AWS_SHARED_CREDENTIALS_FILE=/Users/you/.omicshub/credentials
