{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "omicshub",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "manage.py",
        "runserver",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "omicshub-verify",
      "runtimeExecutable": ".venv/bin/python",
