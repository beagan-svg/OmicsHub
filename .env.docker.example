# Copy to .env.docker and fill in. Read by compose.yaml, never copied into the image.
#
# Deliberately not a copy of the host .env: DATABASE_URL, CELERY_BROKER_URL, CACHE_URL and
# the OCS_CLI_* paths are set by compose.yaml, because in the container they point at
# service names and at the pip-installed CLI rather than at localhost and a macOS venv.

# --- secrets -----------------------------------------------------------------------------
# Any long random string. Rotating it signs every user out, which is the intended effect.
SECRET_KEY=

# Used both to create the database on first run and to connect to it. Changing it after the
# volume exists does not change the password Postgres already stored.
POSTGRES_PASSWORD=

# --- host paths --------------------------------------------------------------------------
# Absolute path to the app-scoped AWS credentials file — the static-key profile, kept out of
# ~/.aws/credentials so it is reachable only from here. Compose does not expand ~.
AWS_CREDENTIALS_FILE=/Users/you/.omicshub/credentials

# --- OCS ---------------------------------------------------------------------------------
# prod is the real account. Table names are built as <base>-fastq-metadata, so this decides
# which environment every read and every submission lands in.
OCS_ENV_BASE=prod
OCS_AWS_REGION=us-west-2
# The profile inside AWS_CREDENTIALS_FILE.
AWS_PROFILE=omicshub

# --- serving -----------------------------------------------------------------------------
# The tunnel host, plus localhost. Django rejects any Host header not listed.
ALLOWED_HOSTS=localhost,127.0.0.1
# The tunnel origin, with scheme. Without it every POST fails CSRF from the tunnel URL.
CSRF_TRUSTED_ORIGINS=https://example-8000.usw2.devtunnels.ms
