# Copy this file to .env.docker and fill in the values. Compose reads it, and Docker does not copy it into the image.
#
# Compose uses these values for PostgreSQL, Redis, the web app, workers, and the OCS CLI.

# --- secrets -----------------------------------------------------------------------------
# Use a long random string. Changing it signs out every user.
SECRET_KEY=

# PostgreSQL uses this password when it creates the database and when the app connects.
# Changing it after the volume exists does not change the stored PostgreSQL password.
POSTGRES_PASSWORD=

# Serve the local app over HTTP on port 8001. Set SECURE_SSL_REDIRECT=True and the secure
# cookie flags to True when an HTTPS proxy serves the app.
WEB_PORT=8001
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CACHE_KEY_PREFIX=omicshub
CACHE_TIMEOUT=300
REDIS_BROKER_PORT=6379
REDIS_CACHE_PORT=6380

# --- host paths --------------------------------------------------------------------------
# Use the absolute path to the AWS credentials file. Compose does not expand ~.
AWS_CREDENTIALS_FILE=/Users/you/.omicshub/credentials

# --- OCS ---------------------------------------------------------------------------------
# Use the prod OCS account. The app reads and submits jobs in this account.
OCS_ENV_BASE=prod
OCS_AWS_REGION=us-west-2
# Use this AWS profile from AWS_CREDENTIALS_FILE.
AWS_PROFILE=omicshub

# --- serving -----------------------------------------------------------------------------
# Accept requests from localhost and the tunnel host.
ALLOWED_HOSTS=localhost,127.0.0.1
# Add the tunnel URL, including its scheme, to allow POST requests through the tunnel.
CSRF_TRUSTED_ORIGINS=
